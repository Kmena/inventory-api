# Dependencies
node_modules/
**/node_modules/

# Environment
.env
.env.*
**/.env
**/.env.*
!.env.example
**/.env.example

# Build artifacts
coverage/
**/coverage/
dist/
**/dist/
build/
**/build/

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
**/.vscode/
.idea/
**/.idea/
*.tmp
*.temp

# Local databases / runtime leftovers
prisma/dev.db
**/prisma/dev.db

# Python cache just in case
__pycache__/
*.pyc

# Docs markdown: ignore all docs/*.md except README.md
**/docs/**/*.md
**/docs/**/*.html
!**/docs/**/README.md
!inventory-api/docs/production-baseline.md
plan/*

*/docs/*.txt
/openspec/*
/specs/*
/docs/*
.codex/*