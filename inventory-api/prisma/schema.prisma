model ProductionReturn {
  id                BigInt                   @id @default(autoincrement())
  stageExecutionId  BigInt                   @map("stage_execution_id")
  productionOrderId BigInt                   @map("production_order_id")
  warehouseId       BigInt                   @map("warehouse_id")
  productId         BigInt                   @map("product_id")
  lotId             BigInt                   @map("lot_id")
  responsibleUserId BigInt?                  @map("responsible_user_id")
  quantity          Decimal                  @db.Decimal(14, 3)
  reasonCode        String                   @map("reason_code")
  note              String?
  movementGroupId   String?                  @map("movement_group_id")
  returnedAt        DateTime                 @map("returned_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  stageExecution    ProductionStageExecution @relation(fields: [stageExecutionId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder          @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lot               Lot                      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([productionOrderId, warehouseId, productId, createdAt])
  @@index([productionOrderId, stageExecutionId, productId, lotId])
  @@index([lotId])
  @@map("production_returns")
}

/// Registro declarativo de materiales perdidos post-rechazo QA de etapa.
/// NO genera movimiento de stock — el stock ya bajó durante el execute.
/// productionStageLoss: material no recuperable tras una ejecución rechazada.
model ProductionStageLoss {
  id                  BigInt                   @id @default(autoincrement())
  companyId           BigInt                   @map("company_id")
  productionOrderId   BigInt                   @map("production_order_id")
  stageExecutionId    BigInt                   @map("stage_execution_id")
  productId           BigInt                   @map("product_id")
  lotId               BigInt                   @map("lot_id")
  quantity            Decimal                  @db.Decimal(14, 3)
  reasonCode          String                   @map("reason_code") @db.VarChar(100)
  note                String?
  registeredByUserId  BigInt?                  @map("registered_by_user_id")
  createdAt           DateTime                 @default(now()) @map("created_at")

  stageExecution      ProductionStageExecution @relation(fields: [stageExecutionId], references: [id], onDelete: Cascade)
  productionOrder     ProductionOrder          @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lot                 Lot                      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([productionOrderId, stageExecutionId], name: "production_stage_losses_order_idx")
  @@index([lotId], name: "production_stage_losses_lot_idx")
  @@map("production_stage_losses")
}

/// Etapa de recolección/recuperación vinculada a un rechazo QA.
/// recoveryType distingue entre flujo legacy (VIRTUAL_RECOLECTION) y el nuevo
/// flujo de reposición de insumos dañados/faltantes (REPLACEMENT_RECOVERY).
/// status=PENDING bloquea la re-ejecución hasta que el operador confirma.
model ProductionRecolectionStage {
  id                  BigInt                          @id @default(autoincrement())
  companyId           BigInt                          @map("company_id")
  productionOrderId   BigInt                          @map("production_order_id")
  /// UNIQUE: solo una recolección por ejecución rechazada.
  rejectedExecutionId BigInt                          @unique @map("rejected_execution_id")
  recipeStageId       BigInt                          @map("recipe_stage_id")
  /// PENDING = esperando confirmación. COMPLETED = material disponible.
  status              String                          @default("PENDING")
  /// VIRTUAL_RECOLECTION (legacy) | REPLACEMENT_RECOVERY (nuevo flujo post-rechazo)
  recoveryType        String                          @default("VIRTUAL_RECOLECTION") @map("recovery_type")
  /// Legacy JSON para compatibilidad con filas existentes.
  requiredItems       Json                            @default("[]") @map("required_items")
  completedByUserId   BigInt?                         @map("completed_by_user_id")
  completedAt         DateTime?                       @map("completed_at")
  notes               String?
  createdAt           DateTime                        @default(now()) @map("created_at")

  company             Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productionOrder     ProductionOrder                 @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rejectedExecution   ProductionStageExecution        @relation(fields: [rejectedExecutionId], references: [id], onDelete: Cascade)
  /// Entradas de recolección por lote (TASK-003: nuevo flujo estructurado)
  recolectionEntries  ProductionRecolectionEntry[]
  /// Registros de conciliación terminal (TASK-003)
  reconciliations     ProductionRecolectionReconciliation[]

  @@index([productionOrderId, status], name: "production_recolection_stages_order_idx")
  @@index([rejectedExecutionId], name: "production_recolection_stages_exec_idx")
  @@map("production_recolection_stages")
}

/// Registro de material recolectado por lote para una etapa de recuperación.
/// Uno por (recolectionStageId, productId, lotId) — permite granularidad por lote.
model ProductionRecolectionEntry {
  id                    BigInt                       @id @default(autoincrement())
  recolectionStageId    BigInt                       @map("recolection_stage_id")
  productId             BigInt                       @map("product_id")
  lotId                 BigInt                       @map("lot_id")
  quantity              Decimal                      @db.Decimal(14, 3)
  unit                  String?
  createdAt             DateTime                     @default(now()) @map("created_at")

  recolectionStage      ProductionRecolectionStage   @relation(fields: [recolectionStageId], references: [id], onDelete: Cascade)
  product               Product                      @relation(fields: [productId], references: [id])
  lot                   Lot                          @relation(fields: [lotId], references: [id])

  @@index([recolectionStageId])
  @@index([productId])
  @@index([lotId])
  @@map("production_recolection_entries")
}

/// Registro de conciliación terminal para material recolectado no usado.
/// outcome: USED | RETURNED | DISCARDED (BR-007, FR-012)
model ProductionRecolectionReconciliation {
  id                    BigInt                       @id @default(autoincrement())
  recolectionStageId    BigInt                       @map("recolection_stage_id")
  productId             BigInt                       @map("product_id")
  lotId                 BigInt                       @map("lot_id")
  quantity              Decimal                      @db.Decimal(14, 3)
  /// USED | RETURNED | DISCARDED
  outcome               String
  notes                 String?
  reconciledAt          DateTime                     @default(now()) @map("reconciled_at")
  createdAt             DateTime                     @default(now()) @map("created_at")

  recolectionStage      ProductionRecolectionStage   @relation(fields: [recolectionStageId], references: [id], onDelete: Cascade)
  product               Product                      @relation(fields: [productId], references: [id])
  lot                   Lot                          @relation(fields: [lotId], references: [id])

  @@index([recolectionStageId])
  @@index([productId])
  @@index([lotId])
  @@map("production_recolection_reconciliations")
}

model QualityInspection {
  id                   BigInt                   @id @default(autoincrement())
  productionOrderId    BigInt                   @map("production_order_id")
  stageExecutionId     BigInt                   @map("stage_execution_id")
  inspectorUserId      BigInt                   @map("inspector_user_id")
  lotId                BigInt?                  @map("lot_id")
  result               QualityInspectionResult
  expectedParameters   Json?                    @map("expected_parameters")
  actualResults        Json?                    @map("actual_results")
  observations         String?
  evidence             Json?
  correctiveAction     String?                  @map("corrective_action")
  inspectedAt          DateTime                 @map("inspected_at")
  /// CURRENT (default) | PRIOR_STAGE — punto de continuación tras rechazo.
  continuationPoint    String?                  @map("continuation_point")
  /// recipeStageId hacia donde retrocede la producción cuando PRIOR_STAGE.
  continuationStageId  BigInt?                  @map("continuation_stage_id")
  /// Snapshot de disposiciones declaradas inline por el inspector.
  materialDispositions Json?                    @map("material_dispositions")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  productionOrder      ProductionOrder          @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageExecution       ProductionStageExecution @relation(fields: [stageExecutionId], references: [id], onDelete: Cascade)
  lot                  Lot?                     @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([productionOrderId, stageExecutionId, createdAt])
  @@index([lotId])
  @@map("quality_inspections")
}

model AuditEvent {
  id            BigInt   @id @default(autoincrement())
  requestId     String   @map("request_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  actorUserId   BigInt?  @map("actor_user_id")
  actorUsername String?  @map("actor_username")
  actorRoleCode String?  @map("actor_role_code")
  companyId     BigInt?  @map("company_id")
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String?  @map("resource_id")
  outcome       String
  reasonCode    String?  @map("reason_code")
  httpMethod    String?  @map("http_method")
  routePattern  String?  @map("route_pattern")
  path          String?
  ip            String?
  userAgent     String?  @map("user_agent")
  beforeState   Json?    @map("before_state")
  afterState    Json?    @map("after_state")
  metadata      Json?
  actorUser     User?    @relation("audit_event_actor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([companyId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_events")
}

model OrderStoreBackfillAudit {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt   @unique @map("order_id")
  companyId BigInt   @map("company_id")
  clientId  BigInt?  @map("client_id")
  reason    String
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("order_store_backfill_audit")
}

model ThrottleEntry {
  scopeKey   String   @id @map("scope_key") @db.Text
  payloadJson String  @map("payload_json") @db.Text
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("throttle_entries")
}

model SupplierQuotationInvitation {
  id                      BigInt                              @id @default(autoincrement())
  companyId               BigInt                              @map("company_id")
  purchaseRequestId       BigInt                              @map("purchase_request_id")
  supplierId              BigInt                              @map("supplier_id")
  quotationId             BigInt?                             @map("quotation_id")
  createdByUserId         BigInt?                             @map("created_by_user_id")
  emailTo                 String?                             @map("email_to")
  tokenHash               String                              @unique @map("token_hash")
  status                  SupplierQuotationInvitationStatus    @default(PENDING)
  expiresAt               DateTime                            @map("expires_at")
  preparedAt              DateTime?                           @map("prepared_at")
  respondedAt             DateTime?                           @map("responded_at")
  cancelledAt             DateTime?                           @map("cancelled_at")
  emailSubject            String?                             @map("email_subject")
  emailBody               String?                             @map("email_body") @db.Text
  responseSource          String?                             @map("response_source")
  manualResponseByUserId  BigInt?                             @map("manual_response_by_user_id")
  manualResponseNotes     String?                             @map("manual_response_notes") @db.Text
  createdAt               DateTime                            @default(now()) @map("created_at")
  updatedAt               DateTime                            @updatedAt @map("updated_at")
  company                 Company                             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequest         PurchaseRequest                     @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  supplier                Supplier                            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quotation               SupplierQuotation?                  @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdByUser           User?                               @relation("rfq_invitation_created_by_user", fields: [createdByUserId], references: [id], onDelete: SetNull)
  manualResponseByUser    User?                               @relation("rfq_invitation_manual_response_by_user", fields: [manualResponseByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, purchaseRequestId])
  @@index([supplierId])
  @@index([status, expiresAt])
  @@map("supplier_quotation_invitations")
}
