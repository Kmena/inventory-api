  recipeId               BigInt?                   @map("recipe_id")
  recipeVersionId        BigInt?                   @map("recipe_version_id")
  originWarehouseId      BigInt?                   @map("origin_warehouse_id")
  destinationWarehouseId BigInt?                   @map("destination_warehouse_id")
  responsibleUserId      BigInt?                   @map("responsible_user_id")
  quantity               Decimal                   @db.Decimal(14, 3)
  plannedOutputKg        Decimal?                  @db.Decimal(14, 3) @map("planned_output_kg")
  status                 ProductionOrderStatus     @default(DRAFT)
  priority               Int                       @default(0)
  responsible            String?
  productionLotCode      String?                   @map("production_lot_code")
  plannedDate            DateTime?                 @map("planned_date")
  productionDate         DateTime?                 @map("production_date")
  expirationDate         DateTime?                 @map("expiration_date")
  submittedAt            DateTime?                 @map("submitted_at")
  approvedAt             DateTime?                 @map("approved_at")
  startedAt              DateTime?                 @map("started_at")
  cancelledAt            DateTime?                 @map("cancelled_at")
  overrideJustification  String?                   @map("override_justification")
  recipeVersionSnapshot  Json?                     @map("recipe_version_snapshot")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  company                Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order                  Order?                    @relation(fields: [orderId], references: [id])
  product                Product?                  @relation("production_order_product", fields: [productId], references: [id])
  recipe                 Recipe?                   @relation(fields: [recipeId], references: [id])
  recipeVersion          RecipeVersion?            @relation(fields: [recipeVersionId], references: [id])
  originWarehouse        Warehouse?                @relation("production_order_origin_warehouse", fields: [originWarehouseId], references: [id])
  destinationWarehouse   Warehouse?                @relation("production_order_destination_warehouse", fields: [destinationWarehouseId], references: [id])
  responsibleUser        User?                     @relation("production_order_responsible_user", fields: [responsibleUserId], references: [id])
  items                  ProductionItem[]
  materialRequirements   ProductionOrderMaterialRequirement[]
  stageExecutions        ProductionStageExecution[]
  consumptions           ProductionConsumption[]
  wastes                 ProductionWaste[]
  returns                ProductionReturn[]
  qualityInspections     QualityInspection[]
  stageLosses            ProductionStageLoss[]
  recolectionStages      ProductionRecolectionStage[]

