model RecipeStage {
  id                    BigInt                    @id @default(autoincrement())
  recipeVersionId       BigInt                    @map("recipe_version_id")
  stageOrder            Int                       @map("stage_order")
  name                  String
  instructions          String?
  responsibleRoleCode   String?                   @map("responsible_role_code")
  responsibleUserId     BigInt?                   @map("responsible_user_id")
  expectedParameters    Json?                     @map("expected_parameters")
  parameterTolerances   Json?                     @map("parameter_tolerances")
  requiredEvidence      Json?                     @map("required_evidence")
  qaMandatory           Boolean                   @default(false) @map("qa_mandatory")
  /// Stage type: RECOLLECTION (recolectar insumos de lote) | PROCESSING (ejecutar proceso sobre insumos).
  /// Legacy stages without explicit type are treated as PROCESSING for backward compatibility.
  stageType             String                    @default("PROCESSING") @map("stage_type")
  /// Required for PROCESSING stages. Must be a value from the approved processCode catalog.
  processCode           String?                   @map("process_code")
  /// Required only when processCode = OTHER. Not required for catalog-backed codes.
  processLabel          String?                   @map("process_label")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  recipeVersion         RecipeVersion             @relation(fields: [recipeVersionId], references: [id], onDelete: Cascade)
  stageInputs           RecipeStageInput[]
  stageExecutions       ProductionStageExecution[]

  @@unique([recipeVersionId, stageOrder])
  @@map("recipe_stages")
}

model RecipeStageInput {
  id            BigInt       @id @default(autoincrement())
  recipeStageId BigInt       @map("recipe_stage_id")
  productId     BigInt?      @map("product_id")
