generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PaymentType {
  CASH
  CREDIT
  TRANSFER
  CARD
}

enum OrderStatus {
  DRAFT
  APPROVED
  IN_PRODUCTION
  DELIVERED
  CANCELLED
  REJECTED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentLifecycleStatus {
  DRAFT
  PENDING_APPROVAL
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVERSED
  CANCELLED
}

enum VisitMotive {
  VENTA
  COBRO
  SEGUIMIENTO
}

enum VisitResult {
  EXITOSA
  PENDIENTE
  SIN_CONTACTO
  REPROGRAMADA
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum WarehouseType {
  GENERAL
  RAW_MATERIAL
  FINISHED_GOODS
  PACKAGING
  QUARANTINE
  RETURNS
  PRODUCTION
  ADMIN_VIRTUAL
  COURSES_VIRTUAL
  AFFILIATIONS_VIRTUAL
}

enum ProductSourcingMethod {
  PRODUCTION_ONLY
  PURCHASE_ONLY
  PRODUCTION_OR_PURCHASE
}

enum ProductInventoryType {
  RAW_MATERIAL
  PACKAGING
  WORK_IN_PROCESS
  FINISHED_GOOD
}

enum ProductPresentationType {
  VOLUME
  MASS
  LENGTH
  COUNT
}

enum ProductNetContentUnit {
  ML
  L
  G
  KG
  M
  UN
}

enum RecipeQuantityBasis {
  PER_OUTPUT_KG
  PER_FINISHED_UNIT
}

enum RecipeVersionStatus {
  DRAFT
  APPROVED
}

enum ProductionOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  QA_HOLD
  CANCELLED
}

enum QualityInspectionResult {
  APPROVED
  CONDITIONALLY_ACCEPTED
  REJECTED
}

enum PurchaseRequestStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum SupplierQuotationStatus {
  SUBMITTED
  SELECTED
  REJECTED
}

enum ProcurementApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum FiscalReferenceStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum PurchaseReceiptStatus {
  DRAFT
  PENDING_INSPECTION
  PARTIALLY_ACCEPTED
  ACCEPTED
  REJECTED
  CONFIRMED
  REVERSED
}

enum ReceiptInspectionResult {
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
}

enum LotStatus {
  AVAILABLE
  QUARANTINED
  EXPIRED
  BLOCKED
  CONSUMED
}

enum LotQaStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum SupplierQuotationInvitationStatus {
  PENDING
  PREPARED
  RESPONDED
  EXPIRED
  CANCELLED
}

enum PaymentConditionType {
  CASH
  TRANSFER
  CREDIT
}

model Role {
  id              BigInt           @id @default(autoincrement())
  code            String           @unique
  name            String
  companyId       BigInt?          @map("company_id")
  isActive        Boolean          @default(true) @map("is_active")
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  @@index([companyId])
}

model Company {
  id            BigInt        @id @default(autoincrement())
  name          String
  legalId       String?       @map("legal_id")
  phone         String?
  email         String?
  address       String?
  isActive      Boolean       @default(true) @map("is_active")
  /// Porcentaje de tolerancia de sobre-consumo de materias primas en producción. Default: 5.00%.
  productionConsumptionTolerancePercent Decimal @default(5.00) @map("production_consumption_tolerance_percent") @db.Decimal(5, 2)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  users         User[]
  roles         Role[]
  regions       Region[]
  warehouses    Warehouse[]
  stockMovements StockMovement[]
  purchaseRequests PurchaseRequest[]
  supplierQuotations SupplierQuotation[]
  supplierSelections SupplierSelection[]
  purchaseOrders PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  lots           Lot[]
  inventoryAlerts InventoryAlert[]
  lotStatusHistory LotStatusHistory[]
  inventory     Inventory?
  clients       Client[]
  clientClassifications ClientClassification[]
  clientLegalEntities ClientLegalEntity[]
  recipes       Recipe[]
  recipeVersions RecipeVersion[]
  products         Product[]
  orders           Order[]
  productionOrders ProductionOrder[]
  productionOrderMaterialRequirements ProductionOrderMaterialRequirement[]
  suppliers        Supplier[]
  companyConfig    CompanyConfig?
  fiscalConfig     CompanyFiscalConfig?
  fiscalSequences  FiscalSequence[]
  salesRoutes            SalesRoute[]
  salesRouteSubzones     SalesRouteSubzone[]
  salesRouteAssignments  SalesRouteAssignment[]
  salesGoals             SalesGoal[]
  routeVisitLogs         RouteVisitLog[]
  auditEvents            AuditEvent[]
  orderStoreBackfillAudits OrderStoreBackfillAudit[]
  fiscalDocumentReferences FiscalDocumentReference[]
  rfqInvitations           SupplierQuotationInvitation[]
  productionRecolectionStages ProductionRecolectionStage[]

  @@map("companies")
}

model Permission {
  id              BigInt           @id @default(autoincrement())
  code            String           @unique
  module          String
  action          String
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           BigInt     @id @default(autoincrement())
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  isEnabled    Boolean    @default(true) @map("is_enabled")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model CompanyFiscalConfig {
  id                           BigInt   @id @default(autoincrement())
  companyId                    BigInt   @unique @map("company_id")
  legalName                    String   @map("legal_name")
  commercialName               String?  @map("commercial_name")
  identificationType           String   @map("identification_type")
  identificationNumber         String   @map("identification_number")
  economicActivityCode         String?  @map("economic_activity_code")
  province                     String?
  canton                       String?
  district                     String?
  neighborhood                 String?
  address                      String?
  email                        String?
  phone                        String?
  haciendaEnvironment          String   @default("STAGING") @map("hacienda_environment")
  certificateStorageRef        String?  @map("certificate_storage_ref")
  certificatePasswordSecretRef String?  @map("certificate_password_secret_ref")
  haciendaUsernameSecretRef    String?  @map("hacienda_username_secret_ref")
  haciendaPasswordSecretRef    String?  @map("hacienda_password_secret_ref")
  defaultBranchCode            String   @default("001") @map("default_branch_code")
  defaultTerminalCode          String   @default("00001") @map("default_terminal_code")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")
  company                      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_fiscal_configs")
}

model FiscalSequence {
  id           BigInt   @id @default(autoincrement())
  companyId    BigInt   @map("company_id")
  documentType String   @map("document_type")
  branchCode   String   @map("branch_code")
  terminalCode String   @map("terminal_code")
  currentNumber BigInt  @default(0) @map("current_number")
  nextNumber   BigInt   @default(1) @map("next_number")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, branchCode, terminalCode])
  @@map("fiscal_sequences")
}

model CompanyConfig {
  id             BigInt   @id @default(autoincrement())
  companyId      BigInt   @unique @map("company_id")
  taxPercentage  Decimal  @default(13.0) @db.Decimal(5, 2) @map("tax_percentage")
  currency       String   @default("CRC")
  pricingMode    String   @default("standard") @map("pricing_mode")
  allowBackorder Boolean  @default(false) @map("allow_backorder")
  settingsJson   Json?    @map("settings_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_configs")
}

model User {
  id                    BigInt                  @id @default(autoincrement())
  companyId             BigInt?                 @map("company_id")
  roleId                BigInt?                 @map("role_id")
  fullName              String                  @map("full_name")
  email                 String?
  username              String                  @unique
  passwordHash          String                  @map("password_hash")
  phone                 String?
  status                UserStatus              @default(ACTIVE)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  company               Company?                @relation(fields: [companyId], references: [id])
  role                  Role?                   @relation(fields: [roleId], references: [id])
  orders                Order[]                 @relation("order_user")
  approvals             Order[]                 @relation("order_approver")
  rejections            Order[]                 @relation("order_rejector")
  dispatches            Order[]                 @relation("order_dispatcher")
  createdProducts       Product[]               @relation("product_creator")
  createdRecipeVersions RecipeVersion[]         @relation("recipe_version_creator")
  approvedRecipeVersions RecipeVersion[]        @relation("recipe_version_approver")
  responsibleProductionOrders ProductionOrder[] @relation("production_order_responsible_user")
  purchaseRequestsCreated PurchaseRequest[] @relation("purchase_request_created_by_user")
  supplierQuotationsCreated SupplierQuotation[] @relation("supplier_quotation_created_by_user")
  supplierSelectionsCreated SupplierSelection[] @relation("supplier_selection_created_by_user")
  supplierSelectionsApproved SupplierSelection[] @relation("supplier_selection_approved_by_user")
  purchaseOrdersCreated PurchaseOrder[] @relation("purchase_order_created_by_user")
  receiptInspectionsCreated ReceiptInspection[] @relation("receipt_inspection_created_by_user")
  fiscalDocumentReferences FiscalDocumentReference[]
  stockMovements        StockMovement[]
  lotStatusHistory      LotStatusHistory[]
  salesRouteAssignments SalesRouteAssignment[]
  salesGoals            SalesGoal[]
  routeVisitLogs        RouteVisitLog[]
  auditEvents           AuditEvent[]            @relation("audit_event_actor")
  rfqInvitationsCreated SupplierQuotationInvitation[] @relation("rfq_invitation_created_by_user")
  rfqInvitationsManualResponse SupplierQuotationInvitation[] @relation("rfq_invitation_manual_response_by_user")
  submittedPayments     Payment[]               @relation("payment_submitter")

  @@index([companyId, id])
  @@map("users")
}

model Region {
  id        BigInt   @id @default(autoincrement())
  companyId BigInt   @map("company_id")
  name      String
  routeCode String?  @map("route_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subregions Subregion[]

  @@unique([companyId, name])
  @@map("regions")
}

model Subregion {
  id        BigInt   @id @default(autoincrement())
  regionId  BigInt   @map("region_id")
  name      String
  routeCode String?  @map("route_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  stores    ClientStore[]
  salesRoutes SalesRouteSubzone[]
  routeVisitLogs RouteVisitLog[]

  @@unique([regionId, name])
  @@map("subregions")
}

model SalesRoute {
  id                 BigInt    @id @default(autoincrement())
  companyId          BigInt    @map("company_id")
  code               String
  name               String
  visitFrequencyDays Int       @default(15) @map("visit_frequency_days")
  nearLimitDays      Int       @default(3) @map("near_limit_days")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subzones           SalesRouteSubzone[]
  assignments        SalesRouteAssignment[]
  visitLogs          RouteVisitLog[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("sales_routes")
}

model SalesRouteSubzone {
  id           BigInt     @id @default(autoincrement())
  companyId    BigInt     @map("company_id")
  salesRouteId BigInt     @map("sales_route_id")
  subregionId  BigInt     @map("subregion_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesRoute   SalesRoute @relation(fields: [salesRouteId], references: [id], onDelete: Cascade)
  subregion    Subregion  @relation(fields: [subregionId], references: [id], onDelete: Cascade)

  @@unique([salesRouteId, subregionId])
  @@index([companyId])
  @@index([subregionId])
  @@map("sales_route_subzones")
}

model SalesRouteAssignment {
  id            BigInt     @id @default(autoincrement())
  companyId     BigInt     @map("company_id")
  userId        BigInt     @map("user_id")
  salesRouteId  BigInt     @map("sales_route_id")
  effectiveFrom DateTime?  @map("effective_from")
  effectiveTo   DateTime?  @map("effective_to")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  salesRoute    SalesRoute @relation(fields: [salesRouteId], references: [id], onDelete: Cascade)

  @@unique([userId, salesRouteId])
  @@index([companyId])
  @@index([userId])
  @@index([salesRouteId])
  @@map("sales_route_assignments")
}

model SalesGoal {
  id            BigInt    @id @default(autoincrement())
  companyId      BigInt   @map("company_id")
  userId         BigInt   @map("user_id")
  title          String
  periodLabel    String?  @map("period_label")
  targetAmount   Decimal  @default(0) @db.Decimal(14, 2) @map("target_amount")
  currentAmount  Decimal  @default(0) @db.Decimal(14, 2) @map("current_amount")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("sales_goals")
}

model Client {
  id             BigInt          @id @default(autoincrement())
  companyId      BigInt          @map("company_id")
  clientClassificationId BigInt? @map("client_classification_id")
  legalEntityId  BigInt?         @map("legal_entity_id")
  code           String?
  name           String
  isActive       Boolean         @default(true) @map("is_active")
  deletedAt      DateTime?       @map("deleted_at")
  legalId        String?         @map("legal_id")
  documentType   String?         @map("document_type")
  economicActivityCode String?   @map("economic_activity_code")
  economicActivityName String?   @map("economic_activity_name")
  emailBilling   String?         @map("email_billing")
  emailCourtesy  String?         @map("email_courtesy")
  phone          String?
  address        String?
  province       String?
  canton         String?
  district       String?
  paymentType    PaymentType     @default(CASH) @map("payment_type")
  paymentDays    Int?            @map("payment_days")
  creditLimit    Decimal         @default(0) @db.Decimal(14, 2) @map("credit_limit")
  creditBalance  Decimal         @default(0) @db.Decimal(14, 2) @map("credit_balance")
  visitAt        DateTime?       @map("visit_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  classification ClientClassification? @relation(fields: [clientClassificationId], references: [id])
  legalEntity    ClientLegalEntity? @relation(fields: [legalEntityId], references: [id])
  stores         ClientStore[]
  contacts       ClientContact[]
  references     ClientReference[]
  documents      ClientDocument[]
  orders         Order[]
  invoices       Invoice[]
  routeVisitLogs RouteVisitLog[]
  orderStoreBackfillAudits OrderStoreBackfillAudit[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([clientClassificationId])
  @@index([legalEntityId])
  @@index([creditBalance])
  @@index([creditLimit])
  @@map("clients")
}

model ClientClassification {
  id        BigInt   @id @default(autoincrement())
  companyId BigInt   @map("company_id")
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients   Client[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@map("client_classifications")
}

model ClientLegalEntity {
  id                   BigInt   @id @default(autoincrement())
  companyId            BigInt   @map("company_id")
  legalName            String   @map("legal_name")
  commercialName       String?  @map("commercial_name")
  identificationType   String?  @map("identification_type")
  identificationNumber String?  @map("identification_number")
  economicActivityCode String?  @map("economic_activity_code")
  economicActivityName String?  @map("economic_activity_name")
  province             String?
  canton               String?
  district             String?
  neighborhood         String?
  address              String?
  email                String?
  phone                String?
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients              Client[]
  stores               ClientStore[]

  @@unique([companyId, identificationNumber])
  @@map("client_legal_entities")
}

model ClientStore {
  id        BigInt   @id @default(autoincrement())
  clientId  BigInt   @map("client_id")
  legalEntityId BigInt? @map("legal_entity_id")
  subregionId BigInt  @map("subregion_id")
  code      String?
  name      String
  storeType String?  @map("store_type")
  locationReference String? @map("location_reference")
  attentionSchedule String? @map("attention_schedule")
  isPrimary Boolean @default(false) @map("is_primary")
  isActive  Boolean @default(true) @map("is_active")
  phone     String?
  address   String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  province  String?
  canton    String?
  district  String?
  creditLimit   Decimal @default(0) @db.Decimal(14, 2) @map("credit_limit")
  creditBalance Decimal @default(0) @db.Decimal(14, 2) @map("credit_balance")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  legalEntity ClientLegalEntity? @relation(fields: [legalEntityId], references: [id])
  subregion Subregion @relation(fields: [subregionId], references: [id])
  representatives ClientStoreRepresentative[]
  orders          Order[]
  routeVisitLogs  RouteVisitLog[]

  @@unique([clientId, code])
  @@index([legalEntityId])
  @@index([subregionId])
  @@index([creditBalance])
  @@map("client_stores")
}

model ClientStoreRepresentative {
  id                   BigInt   @id @default(autoincrement())
  clientStoreId        BigInt   @map("client_store_id")
  fullName             String   @map("full_name")
  identificationNumber String?  @map("identification_number")
  position             String?
  role                 String?
  email                String?
  phonePrimary         String?  @map("phone_primary")
  phoneSecondary       String?  @map("phone_secondary")
  birthday             DateTime?
  importantDate        DateTime? @map("important_date")
  importantDateType    String?  @map("important_date_type")
  comment              String?
  isPrimaryContact     Boolean  @default(false) @map("is_primary_contact")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  store                ClientStore @relation(fields: [clientStoreId], references: [id], onDelete: Cascade)

  @@index([clientStoreId])
  @@map("client_store_representatives")
}

model ClientContact {
  id        BigInt   @id @default(autoincrement())
  clientId  BigInt   @map("client_id")
  name      String
  role      String?
  email     String?
  phone     String?
  mobile    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

model ClientReference {
  id         BigInt   @id @default(autoincrement())
  clientId   BigInt   @map("client_id")
  name       String
  contact    String?
  phone1     String?  @map("phone_1")
  phone2     String?  @map("phone_2")
  termDays   Int?     @map("term_days")
  amount     Decimal? @db.Decimal(14, 2)
  approved   Boolean  @default(false)
  approvedBy String?  @map("approved_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_references")
}

model ClientDocument {
  id             BigInt   @id @default(autoincrement())
  clientId       BigInt   @map("client_id")
  documentType   String   @map("document_type")
  documentNumber String?  @map("document_number")
  fileName       String   @map("file_name")
  mimeType       String?  @map("mime_type")
  fileUrl        String   @map("file_url")
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_documents")
}

model Inventory {
  id        BigInt     @id @default(autoincrement())
  companyId BigInt     @unique @map("company_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories Category[]
  warehouseStocks WarehouseStock[]

  @@map("inventories")
}

model Warehouse {
  id               BigInt          @id @default(autoincrement())
  companyId        BigInt          @map("company_id")
  code             String
  name             String
  warehouseType    WarehouseType   @default(GENERAL) @map("warehouse_type")
  isVirtual        Boolean         @default(false) @map("is_virtual")
  isSellableSource Boolean         @default(false) @map("is_sellable_source")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseStocks  WarehouseStock[]
  warehouseLotStocks WarehouseLotStock[]
  stockMovements   StockMovement[]
  inventoryAlerts  InventoryAlert[]
