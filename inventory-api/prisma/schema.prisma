  recipeId           BigInt?         @map("recipe_id")
  plannedQuantity    Decimal         @db.Decimal(14, 3) @map("planned_quantity")
  consumedQuantity   Decimal         @default(0) @db.Decimal(14, 3) @map("consumed_quantity")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  productionOrder    ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  recipe             Recipe?         @relation(fields: [recipeId], references: [id])

  @@map("production_items")
}

model ProductionStageExecution {
  id                    BigInt             @id @default(autoincrement())
  productionOrderId     BigInt             @map("production_order_id")
  recipeStageId         BigInt             @map("recipe_stage_id")
  stageOrder            Int                @map("stage_order")
  stageName             String             @map("stage_name")
  responsibleUserId     BigInt?            @map("responsible_user_id")
  startedAt             DateTime           @map("started_at")
  endedAt               DateTime           @map("ended_at")
  /// COMPLETED = ejecución finalizada. QA_REJECTED = rechazada por inspector QA.
  status                String             @default("COMPLETED")
  /// true cuando el supervisor declaró las pérdidas (incluso cero). Gate para re-ejecución.
  lossesAcknowledged    Boolean            @default(false) @map("losses_acknowledged")
  lossesAcknowledgedAt  DateTime?          @map("losses_acknowledged_at")
  actualParameters      Json?              @map("actual_parameters")
  qaOutOfTolerance      Boolean            @default(false) @map("qa_out_of_tolerance")
  overrideJustification String?            @map("override_justification")
  evidence              Json?
  notes                 String?
  movementGroupId       String?            @map("movement_group_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  productionOrder       ProductionOrder    @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  recipeStage           RecipeStage        @relation(fields: [recipeStageId], references: [id])
  consumptions          ProductionConsumption[]
  wastes                ProductionWaste[]
  returns               ProductionReturn[]
  qualityInspections    QualityInspection[]
  losses                ProductionStageLoss[]
  recolectionStage      ProductionRecolectionStage?

  @@index([productionOrderId, stageOrder, createdAt])
  @@index([recipeStageId])
  @@index([productionOrderId, recipeStageId, createdAt(sort: Desc)], name: "production_stage_executions_stage_status_idx")
  @@map("production_stage_executions")
}

model ProductionConsumption {
