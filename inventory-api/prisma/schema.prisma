  recipeId               BigInt                   @map("recipe_id")
  versionNumber          Int                      @map("version_number")
  status                 RecipeVersionStatus      @default(DRAFT)
  quantityBasis          RecipeQuantityBasis      @default(PER_OUTPUT_KG) @map("quantity_basis")
  effectiveFrom          DateTime?                @map("effective_from")
  effectiveTo            DateTime?                @map("effective_to")
  expectedYield          Decimal?                 @db.Decimal(14, 3) @map("expected_yield")
  expectedWaste          Decimal?                 @db.Decimal(14, 3) @map("expected_waste")
  yieldTolerancePercent  Decimal?                 @db.Decimal(5, 2) @map("yield_tolerance_percent")
  wasteTolerancePercent  Decimal?                 @db.Decimal(5, 2) @map("waste_tolerance_percent")
  instructions           String?
  notes                  String?
  createdByUserId        BigInt?                  @map("created_by_user_id")
  approvedByUserId       BigInt?                  @map("approved_by_user_id")
  approvedAt             DateTime?                @map("approved_at")
