  lotStrategy      String            @default("TRACKED") @map("lot_strategy")
  inCatalog        Boolean           @default(false) @map("in_catalog")
  netContent       Decimal           @default(0) @db.Decimal(14, 3) @map("net_content")
  netContentUnit   ProductNetContentUnit? @map("net_content_unit")
  conversionFactor Decimal           @default(1) @db.Decimal(14, 6) @map("conversion_factor")
  kgConversionFactor Decimal         @default(1) @db.Decimal(14, 6) @map("kg_conversion_factor")
  minStock         Decimal?          @db.Decimal(14, 3) @map("min_stock")
  maxStock         Decimal?          @db.Decimal(14, 3) @map("max_stock")
  standbyStock     Decimal           @default(0) @db.Decimal(14, 3) @map("standby_stock")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id])
