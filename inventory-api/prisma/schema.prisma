model Order {
  id            BigInt       @id @default(autoincrement())
  companyId      BigInt      @map("company_id")
  clientId      BigInt?      @map("client_id")
  clientStoreId BigInt?      @map("client_store_id")
  userId        BigInt?      @map("user_id")
  approvedById  BigInt?      @map("approved_by_id")
  warehouseId   BigInt?      @map("warehouse_id")
  receiptNumber String?      @map("receipt_number")
  invoiceNumber String?      @map("invoice_number")
  notes         String?
  responsible   String?
  approved      Boolean      @default(false)
  approvedAt    DateTime?    @map("approved_at")
  isCash            Boolean              @default(false) @map("is_cash")
  downPayment       Decimal              @default(0) @db.Decimal(14, 2) @map("down_payment")
  paymentCondition  PaymentConditionType? @map("payment_condition")
  transferMetadata  Json?                 @map("transfer_metadata")
  total             Decimal              @default(0) @db.Decimal(14, 2)
  otherCosts    Decimal      @default(0) @db.Decimal(14, 2) @map("other_costs")
  transport             String?
  // Dispatch / shipping info — filled by warehouse at dispatch time
  transportMethod       String?   @map("transport_method")
  trackingNumber        String?   @map("tracking_number")
  transportResponsible  String?   @map("transport_responsible")
  dispatchedAt          DateTime? @map("dispatched_at")
  dispatchedById        BigInt?   @map("dispatched_by_id")
  status          OrderStatus  @default(DRAFT)
  // Rejection flow: office rejects → REJECTED; agent corrects → DRAFT again
  rejectionReason String?      @map("rejection_reason")
  rejectedById    BigInt?      @map("rejected_by_id")
  rejectedAt      DateTime?    @map("rejected_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client        Client?      @relation(fields: [clientId], references: [id])
  clientStore   ClientStore? @relation(fields: [clientStoreId], references: [id])
  user          User?        @relation("order_user", fields: [userId], references: [id])
  approvedBy    User?        @relation("order_approver", fields: [approvedById], references: [id])
  rejectedBy    User?        @relation("order_rejector", fields: [rejectedById], references: [id])
  dispatchedBy  User?        @relation("order_dispatcher", fields: [dispatchedById], references: [id])
  warehouse     Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  invoices      Invoice[]
  productionOrders ProductionOrder[]
  storeBackfillAudit OrderStoreBackfillAudit?

  @@index([warehouseId])
  @@index([clientStoreId])
  @@index([paymentCondition])
  @@map("orders")
}

