{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/app.js",
    "src/server.js",
    "src/config.js",
    "src/lib/**/*.js",
    "src/middlewares/**/*.js",
    "src/routes/**/*.js",
    "src/services/**/*.js",
    "scripts/generate-local-project-map.js",
    "scripts/migrate-client-documents-to-private-storage.js"
  ],
  "exclude": [
    "node_modules",
    "src/public/**",
    "src/repositories/**",
    "src/schemas/**",
    "tests/**",
    "storage/**",
    "back_end/**",
    "front_end/**",
    "prisma/**",
    "scripts/validate-agent-workspace.js"
  ]
}
