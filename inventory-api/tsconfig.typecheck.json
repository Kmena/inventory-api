{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/app.js",
    "src/server.js",
    "src/config.js",
    "src/lib/**/*.js",
    "src/middlewares/**/*.js",
    "src/routes/**/*.js",
    "src/services/**/*.js",
    "src/schemas/**/*.js",
    "src/repositories/user.repository.js",
    "src/repositories/role.repository.js",
    "src/repositories/warehouse.repository.js",
    "src/repositories/client.repository.js",
    "src/repositories/product.repository.js",
    "src/repositories/sales-route.repository.js",
    "src/repositories/order.repository.js",
    "src/repositories/payment.repository.js",
    "src/repositories/company.repository.js",
    "src/repositories/invoice.repository.js",
    "src/repositories/inventory.repository.js",
    "scripts/generate-local-project-map.js",
    "scripts/migrate-client-documents-to-private-storage.js",
    "scripts/validate-workflow-baseline.js",
    "scripts/validate-operational-readiness.js",
    "scripts/validate-production-baseline.js",
    "src/public/shared/session.js",
    "src/public/shared/auth.js",
    "src/public/login.js"
  ],
  "exclude": [
    "node_modules",
    "tests/**",
    "storage/**",
    "back_end/**",
    "front_end/**",
    "prisma/**",
    "scripts/validate-agent-workspace.js"
  ]
}
