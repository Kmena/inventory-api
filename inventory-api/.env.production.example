# Production baseline example.
# Copy to .env.production or another local file such as .env.production.local.
# Replace every placeholder before using docker-compose.prod.yml or ENV_FILE-based validation.
PORT=2500
NODE_ENV=production
POSTGRES_DB=tracksys
POSTGRES_USER=tracksys
POSTGRES_PASSWORD=replace_me_production_db_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tracksys:replace_me_production_db_password@db:5432/tracksys?schema=public
CORS_ORIGIN=https://inventory.example.com
APP_BASE_URL=https://inventory.example.com
BCRYPT_ROUNDS=12
JWT_SECRET=replace_me_with_a_long_random_secret_value
JWT_EXPIRES_IN=8h
BROWSER_SESSION_STORE_MODE=redis
REDIS_URL=redis://redis:6379/0
HACIENDA_TAXPAYER_LOOKUP_URL=https://api.hacienda.go.cr/fe/ae?identificacion={identification}
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
BILLING_BASE_URL=https://billing.example.com
BILLING_TIMEOUT_MS=10000
BILLING_BOOTSTRAP_SECRET_REF=env:BILLING_BOOTSTRAP_API_KEY
BILLING_BOOTSTRAP_API_KEY=replace_me_with_bootstrap_key_from_secret_manager
BILLING_MANAGED_CREDENTIAL_DIR=/app/storage/billing-managed-credentials
BILLING_MANAGED_CREDENTIAL_KEY=replace_me_with_32_byte_base64_key_from_secret_manager
FISCAL_SCHEDULER_ENABLED=false
FISCAL_IDENTITY_RECOVERY_ENABLED=false
# Required before enabling identity recovery; set to the approved UTC activation boundary.
FISCAL_IDENTITY_RECOVERY_START_AT=
FISCAL_IDENTITY_RECOVERY_MAX_AGE_MS=259200000
FISCAL_IDENTITY_RECOVERY_BATCH_SIZE=10
FISCAL_IDENTITY_RECOVERY_BACKOFF_MS=300000
