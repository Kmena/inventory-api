{
  "name": "inventory-api",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory API con Node, Express, Prisma, PostgreSQL y Docker para modernizar Track_sys",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src scripts tests --max-warnings 0",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "build": "prisma generate",
    "lint:public-runtime": "eslint src/public --max-warnings 0",
    "validate:public-runtime": "node scripts/validate-public-runtime.js",
    "validate:workflow-baseline": "node scripts/validate-workflow-baseline.js",
    "verify": "npm run lint && npm run typecheck && npm run lint:public-runtime && npm run validate:public-runtime && npm run validate:workflow-baseline && npm run build && npm run test",
    "test": "node scripts/run-tests.js",
    "map:local": "node scripts/generate-local-project-map.js",
    "validate:agent-workspace": "node scripts/validate-agent-workspace.js",
    "validate:production-baseline": "node scripts/validate-production-baseline.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:apply-committed-migrations": "node scripts/apply-committed-migrations.js",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "prisma": "^5.22.0",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
