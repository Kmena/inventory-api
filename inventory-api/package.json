{
  "name": "inventory-api",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory API con Node, Express, Prisma, PostgreSQL y Docker para modernizar Track_sys",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src scripts tests --max-warnings 0",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "build": "prisma generate",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test",
    "test": "node --test tests/logging.test.js tests/client-tenant-scope.test.js tests/invoice-tenant-scope.test.js tests/payment-tenant-scope.test.js tests/client-document-security.test.js",
    "map:local": "node scripts/generate-local-project-map.js",
    "validate:agent-workspace": "node scripts/validate-agent-workspace.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "prisma": "^5.22.0",
    "typescript": "^7.0.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
