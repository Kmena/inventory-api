# Dev-only local environment example.
# Copy this file to .env and replace placeholder secrets before using Docker Compose.
PORT=2500
NODE_ENV=development
POSTGRES_DB=tracksys
POSTGRES_USER=tracksys
POSTGRES_PASSWORD=replace_me_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tracksys:replace_me_local_password@db:5432/tracksys?schema=public
CORS_ORIGIN=http://localhost:2500
APP_BASE_URL=http://localhost:2500
BCRYPT_ROUNDS=12
JWT_SECRET=replace_me_local_jwt_secret
JWT_EXPIRES_IN=8h
BROWSER_SESSION_STORE_MODE=redis
REDIS_URL=redis://redis:6379/0
SEED_ROOT_PASSWORD=replace_me_private_seed_password
SEED_ADMIN_PASSWORD=replace_me_private_seed_password
SEED_SALES_PASSWORD=replace_me_private_seed_password
SEED_SALES_AGENT_PASSWORD=replace_me_private_seed_password
SEED_SALES_SUPERVISOR_PASSWORD=replace_me_private_seed_password
SEED_WAREHOUSE_PASSWORD=replace_me_private_seed_password
HACIENDA_TAXPAYER_LOOKUP_URL=https://api.hacienda.go.cr/fe/ae?identificacion={identification}
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search
# For isolated local browser-only work you may override BROWSER_SESSION_STORE_MODE=memory explicitly.
